@page "/drive"
@model MetaSearch.Pages.DriveModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Cloud Drive — 로그인</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지) -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 메인·소개 페이지와 같은 색·글꼴 + 통합 계정 창 -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
    <style>
        .drive-in { max-width: 440px; margin: 0 auto; padding-block: clamp(16px, 6vh, 56px) 48px; display: grid; gap: 20px; }
        .drive-in h1 { font-size: clamp(2rem, 7vw, 2.6rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; }
        .drive-in .lede { margin-top: 0; font-size: 1.05rem; }
        .drive-in .small { font-size: 13px; color: var(--ink-3); }
        .wait { color: var(--ink-2); }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="p-drive">
    <div class="wrap">
        <header class="topbar">
            <a href="/driveindex" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>Cloud Drive 소개</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
            </div>
        </header>

        <main class="drive-in">
            <div>
                <h1>Cloud Drive</h1>
                <p class="lede">domang 계정으로 로그인하면 회원마다 <strong>5GB</strong> 개인 저장 공간이 생깁니다.</p>
            </div>
            <p class="wait" id="wait">드라이브를 여는 중…</p>
            <!-- 로그인이 필요할 때만 auth.js가 채움 -->
            <section id="auth" hidden></section>
            <p class="small">운영자는 서비스 운영과 불법 파일 대응을 위해 저장된 파일을 열람·삭제할 수 있습니다. 자세한 내용은 <a href="/Privacy" style="text-decoration:underline">개인정보처리방침</a>을 확인해 주세요.</p>
        </main>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
    <script src="/js/auth.js" asp-append-version="true"></script>
    <script>
        // 사이트에 로그인돼 있으면 그 회원의 드라이브 토큰을 받아 바로 파일 화면으로
        // (드라이브 전용 아이디는 없어짐 — domang 통합 계정만 사용)
        function enterDrive() {
            return fetch('/api/drive/sso', { method: 'POST', credentials: 'same-origin' }).then(function (r) {
                if (!r.ok) return false;
                return r.json().then(function (j) {
                    try { localStorage.setItem('driveToken', j.token); } catch (e) { }
                    location.replace('/drive/files');
                    return true;
                });
            });
        }
        var box = document.getElementById('auth'), wait = document.getElementById('wait');
        enterDrive().then(function (ok) {
            if (ok) return;
            // 로그인 안 됨 → 같은 페이지 안에서 로그인·회원가입, 끝나면 다시 드라이브로
            wait.hidden = true; box.hidden = false;
            DomangAuth.mount(box, { onDone: function () { enterDrive(); } });
        }).catch(function () { wait.textContent = '서버에 연결하지 못했습니다. 잠시 후 새로고침해 주세요.'; });
    </script>
</body>
</html>
