@page "/driveindex"
@model DriveIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cloud Drive — 회원마다 5GB 무료 클라우드 드라이브 | domang</title>
    <meta name="description" content="domang 계정으로 로그인하면 회원마다 5GB 저장 공간을 주는 개인 클라우드 드라이브. 대용량 업로드, 폴더·즐겨찾기·휴지통, 파일 미리보기를 지원하며 라즈베리파이 서버에서 직접 운영합니다." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/driveindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/driveindex" />
    <meta property="og:title" content="Cloud Drive — 회원마다 5GB 무료 클라우드 드라이브 | domang" />
    <meta property="og:description" content="domang 계정으로 로그인하면 회원마다 5GB 저장 공간을 주는 개인 클라우드 드라이브. 대용량 업로드, 폴더·즐겨찾기·휴지통, 파일 미리보기를 지원하며 라즈베리파이 서버에서 직접 운영합니다." />
    <meta property="og:image" content="https://domang.org/img/og/drive.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cloud Drive — 회원마다 5GB 무료 클라우드 드라이브 | domang" />
    <meta name="twitter:description" content="domang 계정으로 로그인하면 회원마다 5GB 저장 공간을 주는 개인 클라우드 드라이브. 대용량 업로드, 폴더·즐겨찾기·휴지통, 파일 미리보기를 지원하며 라즈베리파이 서버에서 직접 운영합니다." />
    <meta name="twitter:image" content="https://domang.org/img/og/drive.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "Cloud Drive",
      "url": "https://domang.org/drive",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "description": "domang 계정으로 로그인하면 회원마다 5GB 저장 공간을 주는 개인 클라우드 드라이브. 대용량 업로드, 폴더·즐겨찾기·휴지통, 파일 미리보기를 지원하며 라즈베리파이 서버에서 직접 운영합니다.",
      "image": "https://domang.org/img/og/drive.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지). 없으면 기기 설정을 따름 -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <!-- 본문 글꼴: Pretendard (메인 포트폴리오와 같음) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 소개 페이지 공통 스타일 (흰 바탕 편집 디자인, 다크 모드 포함) -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="p-drive">
    <script>document.documentElement.classList.add('js');</script>
    <!-- 광고: 넓은 화면(1290px 이상)에서 본문 양옆 고정 -->
    <aside class="ad-side ad-left" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <aside class="ad-side ad-right" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <div class="wrap">
        <!-- 상단: 포트폴리오로 / 테마 전환 / 바로가기 -->
        <header class="topbar">
            <a href="/" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>domang.org</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <a href="/drive" class="go">Cloud Drive 열기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </div>
        </header>

        <main>
            <!-- 첫 화면: 제목 / 한 문단 / 상태 -->
            <section class="hero">
                <h1>Cloud Drive</h1>
                <p class="lede">파일 업로드·다운로드와 폴더 관리, 청크 업로드로 대용량 파일까지 다루는 개인 클라우드 드라이브입니다. 라즈베리파이 4의 SSD에서 직접 운영합니다.</p>
                <div class="facts"><span class="status"><span class="dot"></span>운영 중</span><span>2026</span><span>회원 전용</span></div>
            </section>

            <!-- 실제 서비스 화면 (브라우저 창 틀) -->
            <figure class="shot">
                <div class="frame">
                    <div class="chrome" aria-hidden="true"><i><b></b><b></b><b></b></i><span>domang.org/drive/files</span></div>
                    <img src="/img/shots/drive.jpg?v=20261123" alt="Cloud Drive 파일 목록 화면 — 폴더와 문서·영상·압축 파일, 왼쪽에 회원 저장 공간 5GB 사용량" width="960" height="600" />
                </div>
                <figcaption>내 드라이브 파일 목록. 예시 파일로 채운 화면입니다.</figcaption>
            </figure>

            <!-- 주요 기능 -->
            <section class="block">
                <h2>주요 기능</h2>
                <div>
                    <ul class="feats">
                        <li><h3>청크 업로드</h3><p>대용량 파일을 여러 조각으로 나누어 업로드합니다. 네트워크 중단에도 이어받기가 가능합니다.</p></li>
                        <li><h3>폴더 관리</h3><p>폴더 생성·이동·삭제, 파일 이름 변경 등 직관적인 파일 탐색기 인터페이스를 제공합니다.</p></li>
                        <li><h3>파일 다운로드 &amp; 미리보기</h3><p>파일을 바로 다운로드하거나 이미지·텍스트 파일은 브라우저에서 미리보기할 수 있습니다.</p></li>
                        <li><h3>회원마다 5GB</h3><p>domang 통합 계정으로 로그인하면 회원마다 따로 5GB 저장 공간이 생깁니다. 기존 가입자도 처음 들어올 때 바로 받습니다. 라즈베리파이에 연결한 SSD에서 직접 서빙합니다.</p></li>
                    </ul>
                </div>
            </section>

            <!-- 광고: 본문 중간 (버튼·링크와 떨어진 자리) -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>

            <!-- 기술 -->
            <section class="block">
                <h2>기술</h2>
                <div>
                    <table class="stack">
                        <tr><th scope="row">서버</th><td>ASP.NET Core 8 · Razor Pages</td></tr>
                        <tr><th scope="row">데이터</th><td>PostgreSQL</td></tr>
                        <tr><th scope="row">저장</th><td>SSD · 청크 업로드</td></tr>
                        <tr><th scope="row">운영</th><td>Raspberry Pi 4 · Nginx</td></tr>
                    </table>
                </div>
            </section>

            <!-- 광고: 본문 끝(기술 소개)과 '열기' 버튼 구역 사이 — 링크·버튼에 붙지 않게 위아래 여백 + 구분선 -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>
            <!-- 직접 써 보기 -->
            <section class="cta">
                <p>직접 써 보세요.</p>
                <a href="/drive" class="go big">Cloud Drive 열기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </section>

            <!-- 다른 프로젝트로 바로 이동 -->
            <nav class="others" aria-label="다른 프로젝트">
                <h2>다른 프로젝트</h2>
                <ul>
                    <li><a href="/metaindex"><b>Meta Search</b><span>통합 검색엔진<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/pokeindex"><b>포켓몬스터 아스테라</b><span>브라우저 팬게임<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/ottindex"><b>OTT Multi-View</b><span>Windows 데스크톱 앱<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                </ul>
            </nav>

        </main>

        <!-- 연락처 & 저작권 -->
        <footer class="fine">
            <span>&copy; 2026 안도영 · <a href="mailto:metasearch@@domang.org">metasearch@@domang.org</a> · 010-2583-1894</span>
            <a href="/Privacy" class="u">개인정보처리방침</a>
        </footer>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
</body>
</html>
